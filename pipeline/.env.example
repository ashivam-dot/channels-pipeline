# Copy to pipeline/.env and fill in. .env is git-ignored: never commit it, never paste its values into a chat or a log.
# One KEY=value per line, no quotes, no spaces around "=". SETUP-GUIDE.md section 4 says where each value comes from.
# Delete every line you leave empty: the loader keeps a key's first line, so an empty line hides a value added later.

# --- Shared by every channel ---
YTC_CONTACT=
# Written by pipeline/modal_secret.py (a random topic); subscribe to it in the ntfy phone app
# YTC_NTFY_TOPIC=
CLOUDINARY_URL=
CIRCLECI_TOKEN=
CIRCLECI_PROJECT=gh/YOUR_GITHUB_USER/channels-pipeline
AK_MEDIA_TOKEN=

# --- Days of Odd: English history Shorts, made on Modal, posted to YouTube through Buffer ---
BUFFER_API_KEY=
BUFFER_YOUTUBE_CHANNEL_ID=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
YTC_GEMINI_API_KEY=
# Optional fallback models, used when Gemini's free quota is spent (a key left empty is skipped)
YTC_MISTRAL_API_KEY=
YTC_OPENROUTER_API_KEY=
YTC_CURSOR_API_KEY=
# Optional picture sources
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# --- Ankahi Kathayein: Hindi mythology Reels on Instagram, mirrored to YouTube and Facebook (CircleCI) ---
IG_GEMINI_API_KEY=
IG_BUFFER_API_KEY=
IG_BUFFER_ORGANIZATION_ID=
IG_BUFFER_CHANNEL_ID=
IG_BUFFER_YOUTUBE_CHANNEL_ID=
IG_BUFFER_FACEBOOK_CHANNEL_ID=
IG_CLOUDFLARE_ACCOUNT_ID=
IG_CLOUDFLARE_API_TOKEN=

# --- Pal Pal News and its current-affairs exam desk: Hindi news Shorts (CircleCI, context news-desk) ---
NEWS_GEMINI_API_KEY=
NEWS_SARVAM_API_KEY=
NEWS_BUFFER_CHANNEL_ID=
NEWS_CLOUDFLARE_ACCOUNT_ID=
NEWS_CLOUDFLARE_API_TOKEN=
# Written by setup/news_youtube_signin.py; don't type it by hand
# NEWS_YOUTUBE_TOKEN=
